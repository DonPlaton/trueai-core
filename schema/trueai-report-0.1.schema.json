{
  "$defs": {
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "description": "Machine-readable description of an artifact included in a report.",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "required": [
        "path",
        "artifact_type"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Artifact types understood by the engine.",
      "enum": [
        "text",
        "markdown",
        "source_code",
        "html",
        "css",
        "svg",
        "docx",
        "pptx",
        "xlsx",
        "odf",
        "legacy_office",
        "pdf",
        "png",
        "jpeg",
        "audio",
        "video",
        "git_repository",
        "directory",
        "binary",
        "unknown"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ConfidenceType": {
      "description": "Nature of the evidence, independent of its numeric strength.",
      "enum": [
        "deterministic",
        "verified",
        "probabilistic",
        "heuristic"
      ],
      "title": "ConfidenceType",
      "type": "string"
    },
    "EvidenceType": {
      "description": "Primary source of a finding.",
      "enum": [
        "text",
        "metadata",
        "git",
        "structural",
        "statistical",
        "provenance",
        "security"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A single explainable observation emitted by one detector.",
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_type": {
          "$ref": "#/$defs/ConfidenceType"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "detector_id": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Detector Id",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Evidence",
          "type": "object"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "id": {
          "maxLength": 80,
          "minLength": 12,
          "title": "Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance_class": {
          "$ref": "#/$defs/ProvenanceClass",
          "default": "none"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "remediation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Id"
        },
        "removable": {
          "default": false,
          "title": "Removable",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "detector_id",
        "category",
        "artifact_path",
        "confidence",
        "confidence_type",
        "severity",
        "evidence_type",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCategory": {
      "description": "Stable taxonomy used by findings and policy rules.",
      "enum": [
        "invisible_unicode",
        "suspicious_unicode",
        "explicit_ai_attribution",
        "generator_metadata",
        "git_attribution",
        "tooling_residue",
        "document_metadata",
        "personal_metadata",
        "image_metadata",
        "media_metadata",
        "c2pa_provenance",
        "provider_watermark",
        "stylistic_signal",
        "design_style_signal",
        "hidden_element",
        "generated_comment",
        "structural_signal",
        "security_issue"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "FindingLocation": {
      "additionalProperties": false,
      "description": "Optional source location in text, bytes, XML, or package parts.",
      "properties": {
        "byte_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Offset"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "package_part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Part"
        }
      },
      "title": "FindingLocation",
      "type": "object"
    },
    "IntegrityReport": {
      "additionalProperties": false,
      "description": "Evidence that remediation changed only approved material.",
      "properties": {
        "after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "intentionally_removed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Intentionally Removed",
          "type": "array"
        },
        "logical_after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical After Sha256"
        },
        "logical_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Before Sha256"
        },
        "status": {
          "$ref": "#/$defs/IntegrityStatus"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "IntegrityReport",
      "type": "object"
    },
    "IntegrityStatus": {
      "description": "Outcome of post-remediation content verification.",
      "enum": [
        "pass",
        "fail",
        "not_verifiable",
        "not_modified"
      ],
      "title": "IntegrityStatus",
      "type": "string"
    },
    "JsonValue": {},
    "PolicyAction": {
      "description": "Actions a policy can assign to a finding.",
      "enum": [
        "ignore",
        "report",
        "review",
        "remove",
        "preserve",
        "error"
      ],
      "title": "PolicyAction",
      "type": "string"
    },
    "PolicyAuditEntry": {
      "additionalProperties": false,
      "description": "Auditable enterprise override applied without hiding the finding.",
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source": {
          "enum": [
            "baseline",
            "suppression",
            "exception",
            "protected"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "source",
        "action",
        "reason"
      ],
      "title": "PolicyAuditEntry",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "description": "Policy action assigned to a finding.",
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "action",
        "rationale"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "ProvenanceAssertion": {
      "additionalProperties": false,
      "description": "One claim carried inside a manifest.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "label",
        "summary"
      ],
      "title": "ProvenanceAssertion",
      "type": "object"
    },
    "ProvenanceClass": {
      "description": "Relationship of a finding to provenance.",
      "enum": [
        "none",
        "attribution",
        "metadata",
        "provenance_metadata",
        "authenticated_provenance",
        "provider_watermark",
        "heuristic"
      ],
      "title": "ProvenanceClass",
      "type": "string"
    },
    "ProvenanceSigner": {
      "additionalProperties": false,
      "description": "Identity the signing certificate asserts, as reported by the verifier.",
      "properties": {
        "algorithm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm"
        },
        "certificate_serial_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificate Serial Number"
        },
        "common_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Common Name"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "signed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed At"
        }
      },
      "title": "ProvenanceSigner",
      "type": "object"
    },
    "ProvenanceValidationEntry": {
      "additionalProperties": false,
      "description": "One check the verifier performed and its outcome.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ValidationOutcome"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "code",
        "outcome",
        "explanation"
      ],
      "title": "ProvenanceValidationEntry",
      "type": "object"
    },
    "ProvenanceVerification": {
      "additionalProperties": false,
      "description": "Result of authenticated verification for one artifact.\n\nA trusted result is the only one that establishes provenance. ``VALID`` means\nthe signature and content hashes check out but the signer is not in the trust\nstore in use, which is a materially weaker statement and is reported as such.",
      "properties": {
        "active_manifest_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Manifest Label"
        },
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceAssertion"
          },
          "title": "Assertions",
          "type": "array"
        },
        "claim_generator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Generator"
        },
        "embedded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedded"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "ingredients": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ingredients",
          "type": "array"
        },
        "remote_manifest_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Manifest Url"
        },
        "remote_manifests_allowed": {
          "default": false,
          "title": "Remote Manifests Allowed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "signer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenanceSigner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/ProvenanceVerificationStatus"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "trust_anchors_configured": {
          "default": false,
          "title": "Trust Anchors Configured",
          "type": "boolean"
        },
        "validation": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceValidationEntry"
          },
          "title": "Validation",
          "type": "array"
        },
        "verifier": {
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "status",
        "verifier",
        "explanation"
      ],
      "title": "ProvenanceVerification",
      "type": "object"
    },
    "ProvenanceVerificationStatus": {
      "description": "Outcome of authenticated C2PA verification, distinct from marker discovery.",
      "enum": [
        "trusted",
        "valid",
        "invalid",
        "no_manifest",
        "unsupported_container",
        "verifier_unavailable"
      ],
      "title": "ProvenanceVerificationStatus",
      "type": "string"
    },
    "ScanDiagnostic": {
      "additionalProperties": false,
      "description": "Non-finding information about skipped or malformed inputs.",
      "properties": {
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "info"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScanDiagnostic",
      "type": "object"
    },
    "ScanSummary": {
      "additionalProperties": false,
      "description": "Precomputed counts for stable clients.",
      "properties": {
        "artifact_count": {
          "minimum": 0,
          "title": "Artifact Count",
          "type": "integer"
        },
        "by_category": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Category",
          "type": "object"
        },
        "by_confidence_type": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Confidence Type",
          "type": "object"
        },
        "by_severity": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Severity",
          "type": "object"
        },
        "finding_count": {
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "review_count": {
          "default": 0,
          "minimum": 0,
          "title": "Review Count",
          "type": "integer"
        },
        "violation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Violation Count",
          "type": "integer"
        }
      },
      "required": [
        "artifact_count",
        "finding_count"
      ],
      "title": "ScanSummary",
      "type": "object"
    },
    "Severity": {
      "description": "Operational importance, not a claim about authorship.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationOutcome": {
      "description": "Category a verifier assigned to one validation entry.",
      "enum": [
        "success",
        "informational",
        "failure"
      ],
      "title": "ValidationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned top-level report schema.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "detectors_run": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Detectors Run",
      "type": "array"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScanDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityReport"
    },
    "package_version": {
      "default": "0.1.0-dev",
      "title": "Package Version",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy"
    },
    "policy_audit": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PolicyAuditEntry"
      },
      "title": "Policy Audit",
      "type": "array"
    },
    "policy_bundle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Bundle Id"
    },
    "policy_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PolicyDecision"
      },
      "title": "Policy Decisions",
      "type": "array"
    },
    "provenance_verifications": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceVerification"
      },
      "title": "Provenance Verifications",
      "type": "array"
    },
    "scan_id": {
      "format": "uuid",
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ScanSummary"
    }
  },
  "required": [
    "artifact",
    "artifacts",
    "summary",
    "findings"
  ],
  "title": "ScanReport",
  "type": "object"
}
