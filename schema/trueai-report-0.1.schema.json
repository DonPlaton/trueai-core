{
  "$defs": {
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "description": "Machine-readable description of an artifact included in a report.",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "required": [
        "path",
        "artifact_type"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Artifact types understood by the engine.",
      "enum": [
        "text",
        "markdown",
        "source_code",
        "html",
        "css",
        "svg",
        "docx",
        "pptx",
        "xlsx",
        "pdf",
        "png",
        "jpeg",
        "git_repository",
        "directory",
        "binary",
        "unknown"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ConfidenceType": {
      "description": "Nature of the evidence, independent of its numeric strength.",
      "enum": [
        "deterministic",
        "verified",
        "probabilistic",
        "heuristic"
      ],
      "title": "ConfidenceType",
      "type": "string"
    },
    "EvidenceType": {
      "description": "Primary source of a finding.",
      "enum": [
        "text",
        "metadata",
        "git",
        "structural",
        "statistical",
        "provenance",
        "security"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A single explainable observation emitted by one detector.",
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_type": {
          "$ref": "#/$defs/ConfidenceType"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "detector_id": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Detector Id",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Evidence",
          "type": "object"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "id": {
          "maxLength": 80,
          "minLength": 12,
          "title": "Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance_class": {
          "$ref": "#/$defs/ProvenanceClass",
          "default": "none"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "remediation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Id"
        },
        "removable": {
          "default": false,
          "title": "Removable",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "detector_id",
        "category",
        "artifact_path",
        "confidence",
        "confidence_type",
        "severity",
        "evidence_type",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCategory": {
      "description": "Stable taxonomy used by findings and policy rules.",
      "enum": [
        "invisible_unicode",
        "suspicious_unicode",
        "explicit_ai_attribution",
        "generator_metadata",
        "git_attribution",
        "tooling_residue",
        "document_metadata",
        "personal_metadata",
        "image_metadata",
        "c2pa_provenance",
        "provider_watermark",
        "stylistic_signal",
        "design_style_signal",
        "hidden_element",
        "generated_comment",
        "structural_signal",
        "security_issue"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "FindingLocation": {
      "additionalProperties": false,
      "description": "Optional source location in text, bytes, XML, or package parts.",
      "properties": {
        "byte_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Offset"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "package_part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Part"
        }
      },
      "title": "FindingLocation",
      "type": "object"
    },
    "IntegrityReport": {
      "additionalProperties": false,
      "description": "Evidence that remediation changed only approved material.",
      "properties": {
        "after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "intentionally_removed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Intentionally Removed",
          "type": "array"
        },
        "logical_after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical After Sha256"
        },
        "logical_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Before Sha256"
        },
        "status": {
          "$ref": "#/$defs/IntegrityStatus"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "IntegrityReport",
      "type": "object"
    },
    "IntegrityStatus": {
      "description": "Outcome of post-remediation content verification.",
      "enum": [
        "pass",
        "fail",
        "not_verifiable",
        "not_modified"
      ],
      "title": "IntegrityStatus",
      "type": "string"
    },
    "JsonValue": {},
    "PolicyAction": {
      "description": "Actions a policy can assign to a finding.",
      "enum": [
        "ignore",
        "report",
        "review",
        "remove",
        "preserve",
        "error"
      ],
      "title": "PolicyAction",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "description": "Policy action assigned to a finding.",
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "action",
        "rationale"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "ProvenanceClass": {
      "description": "Relationship of a finding to provenance.",
      "enum": [
        "none",
        "attribution",
        "metadata",
        "provenance_metadata",
        "authenticated_provenance",
        "provider_watermark",
        "heuristic"
      ],
      "title": "ProvenanceClass",
      "type": "string"
    },
    "ScanDiagnostic": {
      "additionalProperties": false,
      "description": "Non-finding information about skipped or malformed inputs.",
      "properties": {
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "info"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScanDiagnostic",
      "type": "object"
    },
    "ScanSummary": {
      "additionalProperties": false,
      "description": "Precomputed counts for stable clients.",
      "properties": {
        "artifact_count": {
          "minimum": 0,
          "title": "Artifact Count",
          "type": "integer"
        },
        "by_category": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Category",
          "type": "object"
        },
        "by_confidence_type": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Confidence Type",
          "type": "object"
        },
        "by_severity": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Severity",
          "type": "object"
        },
        "finding_count": {
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "review_count": {
          "default": 0,
          "minimum": 0,
          "title": "Review Count",
          "type": "integer"
        },
        "violation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Violation Count",
          "type": "integer"
        }
      },
      "required": [
        "artifact_count",
        "finding_count"
      ],
      "title": "ScanSummary",
      "type": "object"
    },
    "Severity": {
      "description": "Operational importance, not a claim about authorship.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned top-level report schema.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "detectors_run": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Detectors Run",
      "type": "array"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScanDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityReport"
    },
    "package_version": {
      "default": "0.1.0-dev",
      "title": "Package Version",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy"
    },
    "policy_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PolicyDecision"
      },
      "title": "Policy Decisions",
      "type": "array"
    },
    "scan_id": {
      "format": "uuid",
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ScanSummary"
    }
  },
  "required": [
    "artifact",
    "artifacts",
    "summary",
    "findings"
  ],
  "title": "ScanReport",
  "type": "object"
}
